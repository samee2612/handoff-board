# Supabase is optional for the local synthetic-data demo. Add these to enable persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for Step 4 persistence; never expose this as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Keep development/test runs inexpensive. Set to gpt-6-astra only for high-capability evaluation.
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
