# Supabase is optional for the local synthetic-data demo. Add these to enable persistence.
# Required in Vercel Preview and Production environments. This demo must never use real data.
HANDOFF_BOARD_DATA_MODE=synthetic-only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only managed secret. Required for Step 4 persistence; never expose this as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Keep development/test runs inexpensive. Set to gpt-6-astra only for high-capability evaluation.
OPENAI_MODEL=gpt-5-mini
# Server-only managed secret for intentional offline evaluation only; not used by the public refresh route.
OPENAI_API_KEY=
